DOCQA_DATA_DIR=data
DOCQA_PARSER=docling
DOCQA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
DOCQA_RERANKER_MODEL=BAAI/bge-reranker-base
DOCQA_DEVICE=cpu
DOCQA_LOCAL_MODELS_ONLY=false
DOCQA_ENABLE_OCR=true
DOCQA_ENABLE_CLIP=false
DOCQA_CLIP_MODEL=ViT-B-16
DOCQA_CLIP_MODEL_DIR=models/chinese-clip
DOCQA_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 生成后端：bailian（默认）或 ollama。Ollama 不需要云端 API Key。
DOCQA_GENERATION_PROVIDER=bailian
# 填百炼 API Key，不是阿里云 AccessKey ID / AccessKey Secret；须与上方地域地址匹配。
DOCQA_API_KEY=
DOCQA_GENERATION_MODEL=qwen3-vl-plus-2025-12-19
# Ollama 本地接口和模型（选择 ollama 后生效）
DOCQA_OLLAMA_BASE=http://127.0.0.1:11434/api
DOCQA_OLLAMA_MODEL=qwen2.5vl:7b
DOCQA_OLLAMA_KEEP_ALIVE=10m
DOCQA_MAX_API_CALLS=100
DOCQA_API_TIMEOUT=60
DOCQA_API_URL=http://127.0.0.1:8000

# 本地图片理解允许更长等待时间（秒），独立于云端超时
DOCQA_OLLAMA_TIMEOUT=300
DOCQA_OLLAMA_CONTEXT_LENGTH=8192
